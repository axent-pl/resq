{{- /* templates/assessment.html.tmpl */ -}}
<!doctype html>
<html lang="pl">
<head>
  <meta charset="utf-8">
  <title>Raport interwencji</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <!-- Bootstrap 5 -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    .range-wrap{display:flex;gap:.75rem;align-items:center}
    .section-hint{font-size:.9rem;color:#6c757d}
  </style>
</head>
<body class="bg-light">
<div class="container py-4">
  <header class="mb-4">
    <h1 class="mb-1">Raport interwencji</h1>
    <p class="section-hint mb-0">Formularz wewnętrzny — użytek w ramach organizacji ratowniczej</p>
  </header>

  <form method="post" action="{{.PostAction}}">
    <div class="card mb-4">
      <div class="card-body">
        <div class="col-md-4">
          <label class="form-label" for="teamId">Zespół / załoga</label>
          <input type="text" class="form-control" id="teamId" name="team_id" placeholder="np. Sekcja 3 / Patrol B" value="{{.Values.TeamID}}">
        </div>
      </div>
    </div>

    <h2>Zdarzenie</h2>
    <div class="card mb-4">
      <div class="card-body">
        <div class="row g-3">
          <div class="col-md-4">
            <label class="form-label" for="incidentTime">Czas zdarzenia</label>
            <input type="datetime-local" class="form-control" id="incidentTime" name="incident_time" value="{{ .Values.IncidentTime | formatDate }}">
          </div>
          <div class="col-md-8">
            <label class="form-label" for="location">Miejsce zdarzenia</label>
            <input type="text" class="form-control" id="location" name="location" placeholder="Ulica, miasto / opis" value="{{.Values.Location}}">
          </div>
        
          <div class="col-md-2">
            <label class="form-label">Szerokość</label>
            <input type="text" class="form-control" id="lat" readonly>
          </div>
          <div class="col-md-2">
            <label class="form-label">Wysokość</label>
            <input type="text" class="form-control" id="lng" readonly>
          </div>

          <div class="col-md-12">
            <a class="btn btn-secondary" id="getLocationBtn">Lokalizuj</a>
          </div>

        </div>
      </div>
    </div>

    <h2>Poszkodowany</h2>
    <div class="card mb-4">
      <div class="card-body">
        <div class="row g-3">
          <div class="col-md-4">
            <label class="form-label" for="patientName">Imię i nazwisko</label>
            <input type="text" class="form-control" id="patientName" name="patient_name" value="{{.Values.PatientName}}">
          </div>
          <div class="col-md-2">
            <label class="form-label" for="patientAge">Wiek</label>
            <input type="text" min="0" max="120" class="form-control" id="patientAge" name="patient_age" value="{{.Values.PatientAge}}">
          </div>
          <div class="col-md-2">
            <label class="form-label" for="patientPESEL">PESEL</label>
            <input type="number" min="0" max="120" class="form-control" id="patientPESEL" name="patient_pesel" value="{{.Values.PatientPESEL}}">
          </div>
          <div class="col-md-2">
            <label class="form-label" for="patientSex">Płeć</label>
            <select id="patientSex" class="form-select" name="patient_sex">
              <option value="" {{if eq .Values.PatientSex ""}}selected{{end}} disabled>Wybierz…</option>
              <option value="F" {{if eq .Values.PatientSex "F"}}selected{{end}}>K</option>
              <option value="M" {{if eq .Values.PatientSex "M"}}selected{{end}}>M</option>
              <option value="X" {{if eq .Values.PatientSex "X"}}selected{{end}}>Inna / nie podano</option>
            </select>
          </div>
        </div>
      </div>
    </div>

    <div class="accordion mb-4" id="sampleAccordion">
      <!-- S -->
      <div class="accordion-item">
        <h2 class="accordion-header" id="headingS">
          <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapseS" aria-expanded="true" aria-controls="collapseS">
            S — Objawy (Signs & Symptoms)
          </button>
        </h2>
        <div id="collapseS" class="accordion-collapse collapse show" aria-labelledby="headingS" data-bs-parent="#sampleAccordion">
          <div class="accordion-body">
            <div class="mb-3">
              <label class="form-label" for="symptoms">Opis objawów</label>
              <textarea class="form-control" id="symptoms" name="symptoms" rows="3" placeholder="Co widzisz? Co zgłasza poszkodowany?">{{.Values.Symptoms}}</textarea>
            </div>
          </div>
        </div>
      </div>
      <!-- A -->
      <div class="accordion-item">
        <h2 class="accordion-header" id="headingA">
          <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseA" aria-expanded="false" aria-controls="collapseA">
            A — Alergie (Allergies)
          </button>
        </h2>
        <div id="collapseA" class="accordion-collapse collapse" aria-labelledby="headingA" data-bs-parent="#sampleAccordion">
          <div class="accordion-body">
            <textarea class="form-control" name="allergies" rows="2" placeholder="Leki, pokarmy, lateks itp.">{{.Values.Allergies}}</textarea>
          </div>
        </div>
      </div>
      <!-- M -->
      <div class="accordion-item">
        <h2 class="accordion-header" id="headingM">
          <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseM" aria-expanded="false" aria-controls="collapseM">
            M — Leki (Medications)
          </button>
        </h2>
        <div id="collapseM" class="accordion-collapse collapse" aria-labelledby="headingM" data-bs-parent="#sampleAccordion">
          <div class="accordion-body">
            <textarea class="form-control" name="medications" rows="2" placeholder="Aktualnie przyjmowane leki">{{.Values.Medications}}</textarea>
          </div>
        </div>
      </div>
      <!-- P -->
      <div class="accordion-item">
        <h2 class="accordion-header" id="headingP">
          <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseP" aria-expanded="false" aria-controls="collapseP">
            P — Przeszłość chorobowa (Past medical history)
          </button>
        </h2>
        <div id="collapseP" class="accordion-collapse collapse" aria-labelledby="headingP" data-bs-parent="#sampleAccordion">
          <div class="accordion-body">
            <textarea class="form-control" name="past" rows="2" placeholder="Choroby przewlekłe, hospitalizacje, urazy">{{.Values.Past}}</textarea>
          </div>
        </div>
      </div>
      <!-- L -->
      <div class="accordion-item">
        <h2 class="accordion-header" id="headingL">
          <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseL" aria-expanded="false" aria-controls="collapseL">
            L — Ostatni posiłek / płyny (Last oral intake)
          </button>
        </h2>
        <div id="collapseL" class="accordion-collapse collapse" aria-labelledby="headingL" data-bs-parent="#sampleAccordion">
          <div class="accordion-body">
            <textarea class="form-control" name="last" rows="2" placeholder="Co i kiedy jadł/pił?">{{.Values.LastIntake}}</textarea>
          </div>
        </div>
      </div>
      <!-- E -->
      <div class="accordion-item">
        <h2 class="accordion-header" id="headingE">
          <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseE" aria-expanded="false" aria-controls="collapseE">
            E — Wydarzenia prowadzące (Events)
          </button>
        </h2>
        <div id="collapseE" class="accordion-collapse collapse" aria-labelledby="headingE" data-bs-parent="#sampleAccordion">
          <div class="accordion-body">
            <textarea class="form-control" name="events" rows="3" placeholder="Co się wydarzyło bezpośrednio przed wystąpieniem objawów/urazu?">{{.Values.Events}}</textarea>
          </div>
        </div>
      </div>
    </div>

    <!-- Parametry życiowe -->
    <div class="card mb-4">
      <div class="card-header">
        <strong>Parametry poszkodowanego</strong>
        <div class="section-hint">Wprowadź ręcznie lub użyj suwaka — do serwera trafia wartość z pola liczbowego.</div>
      </div>
      <div class="card-body">
        <div class="row g-4">
          <!-- Tętno -->
          <div class="col-md-6">
            <label class="form-label">Tętno (ud./min)</label>
            <div class="range-wrap">
              <input type="number" class="form-control" style="max-width:120px"
                     id="hr_num" name="vitals_hr" min="20" max="220" step="1" value="{{or .Values.HR 80}}">
              <input type="range" class="form-range flex-grow-1"
                     id="hr_rng" min="20" max="220" step="1" data-sync="#hr_num">
            </div>
          </div>
          <!-- SpO₂ -->
          <div class="col-md-6">
            <label class="form-label">SpO₂ (%)</label>
            <div class="range-wrap">
              <input type="number" class="form-control" style="max-width:120px"
                     id="spo2_num" name="vitals_spo2" min="50" max="100" step="1" value="{{or .Values.SpO2 98}}">
              <input type="range" class="form-range flex-grow-1"
                     id="spo2_rng" min="50" max="100" step="1" data-sync="#spo2_num">
            </div>
          </div>
          <!-- Ciśnienie -->
          <div class="col-md-6">
            <label class="form-label">Ciśnienie tętnicze (mmHg)</label>
            <div class="range-wrap">
                <input type="number" class="form-control" style="max-width:120px" id="bp_sys_num" name="vitals_bp_sys" min="50" max="260" step="1" value="{{or .Values.BPSys 120}}" placeholder="Skurczowe">
                <input type="range" class="form-range" id="bp_sys_rng" min="50" max="260" step="1" data-sync="#bp_sys_num">
            </div>
          </div>
          <div class="col-md-6">
            <div class="range-wrap">
                <input type="number" class="form-control" style="max-width:120px" id="bp_dia_num" name="vitals_bp_dia" min="30" max="160" step="1" value="{{or .Values.BPDia 80}}" placeholder="Rozkurczowe">
                <input type="range" class="form-range" id="bp_dia_rng" min="30" max="160" step="1" data-sync="#bp_dia_num">
            </div>
          </div>
          <!-- Glukoza -->
          <div class="col-md-6">
            <label class="form-label">Glukoza (mg/dL)</label>
            <div class="range-wrap">
              <input type="number" class="form-control" style="max-width:140px"
                     id="glu_num" name="vitals_glucose" min="20" max="600" step="1" value="{{or .Values.Glucose 100}}">
              <input type="range" class="form-range flex-grow-1"
                     id="glu_rng" min="20" max="600" step="1" data-sync="#glu_num">
            </div>
          </div>
          <!-- Inne obserwacje -->
          <div class="col-12">
            <label class="form-label" for="notes">Dodatkowe uwagi / badanie urazowe</label>
            <textarea class="form-control" id="notes" name="notes" rows="3" placeholder="ABC, urazy, ból, skala bólu, GCS itp.">{{.Values.Notes}}</textarea>
          </div>
        </div>
      </div>
    </div>

    <!-- Działania -->
    <div class="card mb-4">
      <div class="card-header"><strong>Działania / interwencje</strong></div>
      <div class="card-body">
        <div class="row g-3">
          <div class="col-md-6">
            <label class="form-label" for="interventions">Zastosowane działania</label>
            <textarea class="form-control" id="interventions" name="interventions" rows="2" placeholder="Tlen, opatrunki, pozycjonowanie, glukoza doustna, itp.">{{.Values.Interventions}}</textarea>
          </div>
          <div class="col-md-6">
            <label class="form-label" for="transport">Transport / przekazanie</label>
            <textarea class="form-control" id="transport" name="handoff" rows="2" placeholder="Dokąd, komu, o której">{{.Values.Handoff}}</textarea>
          </div>
        </div>
      </div>
    </div>

    <div class="d-flex gap-2">
      <button type="submit" class="btn btn-primary">Zapisz</button>
      <button type="reset" class="btn btn-outline-secondary">Wyczyść</button>
    </div>
  </form>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
  function syncPair(rangeEl){
    const numSel = rangeEl.getAttribute('data-sync');
    const numEl = document.querySelector(numSel);
    if(!numEl) return;

    rangeEl.value = numEl.value || rangeEl.min;

    rangeEl.addEventListener('input', () => { numEl.value = rangeEl.value; });
    numEl.addEventListener('input', () => {
      const v = Number(numEl.value);
      if(!Number.isFinite(v)) return;
      const min = Number(rangeEl.min), max = Number(rangeEl.max);
      rangeEl.value = Math.min(Math.max(v, min), max);
    });
  }
  document.querySelectorAll('input[type="range"][data-sync]').forEach(syncPair);
</script>
  <script>
    async function askIfAllowed() {
      if (!navigator.permissions) return null;
      try {
        const p = await navigator.permissions.query({ name: "geolocation" });
        return p.state; // "granted" | "prompt" | "denied"
      } catch {
        return null;
      }
    }

    function getLocation() {
      return new Promise((resolve, reject) => {
        if (!("geolocation" in navigator)) return reject(new Error("No geolocation support"));

        navigator.geolocation.getCurrentPosition(
          pos => resolve(pos.coords),
          err => reject(err),
          { enableHighAccuracy: true, timeout: 10000 }
        );
      });
    }

    async function setCoordinates() {
      const state = await askIfAllowed();
      console.log("Permission state:", state);

      if (state === "denied") {
        alert("Location access denied. Please enable it in your browser settings.");
        return false;
      }

      try {
        const coords = await getLocation();
        document.getElementById("lat").value = coords.latitude;
        document.getElementById("lng").value = coords.longitude;
      } catch (err) {
        alert("Failed to get location: " + err.message);
      }

      return false;
    }

    document.getElementById("getLocationBtn")
            .addEventListener("click", setCoordinates);
  </script>
</body>
</html>