{{if not .Reports}}
<div class="alert alert-info">Brak raportów spełniających kryteria.</div>
{{end}}

<div class="row row-cols-1 row-cols-md-2 g-3" hx-get="/reports" hx-trigger="reportUpdated from:body" hx-swap="innerHTML">
{{ template "reports_list" . }}
</div>

<div class="modal fade" id="report-details-modal" tabindex="-1" aria-hidden="true">
<div class="modal-dialog modal-xl modal-dialog-scrollable">
    <div class="modal-content" id="report-details-content">
        <div class="modal-body">
            <div class="text-center py-4">
                <div class="spinner-border" role="status"><span class="visually-hidden">Ładowanie...</span></div>
            </div>
        </div>
    </div>
</div>
</div>

    <div class="mt-4 d-flex gap-2">
      <a class="btn btn-primary w-50" href="/reports/new">Nowa interwencja</a>
      <a class="btn btn-secondary w-50" href="/reports/export">Export</a>
    </div>

{{/* Pagination (optional) */}}
{{with .Pagination}}
{{if gt .TotalPages 1}}
    <nav class="mt-3" aria-label="Stronicowanie">
    <ul class="pagination pagination-sm">
        {{/* simplistic example; wire up real links with current filters */}}
        <li class="page-item {{if eq .Page 1}}disabled{{end}}"><a class="page-link" href="?page={{sub .Page 1}}">«</a></li>
        <li class="page-item disabled"><span class="page-link">Strona {{.Page}} / {{.TotalPages}}</span></li>
        <li class="page-item {{if eq .Page .TotalPages}}disabled{{end}}"><a class="page-link" href="?page={{add .Page 1}}">»</a></li>
    </ul>
    </nav>
{{end}}

{{end}}
{{end}}

{{define "full_view"}}
  {{template "layout" .}}
{{end}}

{{define "xhr_view"}}
 {{ template "reports_list" . }}
{{end}}
