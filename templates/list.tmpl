{{define "title"}}Lista raportów{{end}}

{{define "reports_list"}}
{{range .Reports}}
    <div class="col">
    <div class="card card-hover shadow-sm h-100">
        <div class="card-body d-flex flex-column">
        <div class="d-flex justify-content-between align-items-start mb-2">
            <h6 class="card-title mb-0">{{.IncidentLocation}} &bull; {{.IncidentTime.Format "2006-01-02 15:04"}}</h6>
            <span class="badge text-bg-secondary">v{{.Version}}</span>
        </div>
        <div class="mb-2">
            <span class="badge text-bg-light">{{.PatientName}}</span>
            {{if gt .PatientAge 0}}<span class="badge text-bg-light">{{.PatientAge}} lat</span>{{end}}
            {{if .PatientSex}}<span class="badge text-bg-light">{{.PatientSex}}</span>{{end}}
        </div>
        <div class="d-flex flex-wrap gap-1 mb-2">
            {{if gt .HR 0}}<span class="badge text-bg-primary vital-badge">HR {{.HR}}</span>{{end}}
            {{if gt .SpO2 0}}<span class="badge text-bg-primary vital-badge">SpO₂ {{.SpO2}}%</span>{{end}}
            {{if or (gt .BPSys 0) (gt .BPDia 0)}}<span class="badge text-bg-primary vital-badge">BP {{.BPSys}}/{{.BPDia}}</span>{{end}}
            {{if gt .Glucose 0}}<span class="badge text-bg-primary vital-badge">Glu {{.Glucose}}</span>{{end}}
        </div>
        <p class="card-text text-truncate">{{.Symptoms}}</p>
        <div class="d-flex gap-2 mt-auto">
            <button class="btn btn-outline-secondary btn-sm" type="button" hx-get="/reports/view/{{.Id}}?v={{.Version}}" hx-target="#report-details-content" hx-swap="innerHTML" data-bs-toggle="modal" data-bs-target="#report-details-modal">Szczegóły</button>
            <button class="btn btn-primary btn-sm" type="button" hx-get="/reports/edit/{{.Id}}?v={{.Version}}" hx-target="#report-details-content" hx-swap="innerHTML" data-bs-toggle="modal" data-bs-target="#report-details-modal">Edycja</button>
            <button class="btn btn-success btn-sm" type="button" hx-get="/reports/version/{{.Id}}?v={{.Version}}" hx-target="#report-details-content" hx-swap="innerHTML" data-bs-toggle="modal" data-bs-target="#report-details-modal">Kolejne badanie</button>
        </div>
        </div>
    </div>
    </div>
{{end}}
{{end}}

