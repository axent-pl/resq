{{define "title"}}Lista raportów{{end}}
{{define "content"}}
<form class="row g-2 align-items-end mb-3" method="GET" action="/reports">
<input type="hidden" name="csrf" value="{{.CSRFToken}}">
<div class="col-12 col-sm-5">
    <label class="form-label" for="filter-author">Autor</label>
    <select id="filter-author" class="form-select" name="author">
    <option value="">(wszyscy)</option>
    {{range .Authors}}
        <option value="{{.}}" {{if eq $.Filters.Author .}}selected{{end}}>{{.}}</option>
    {{end}}
    </select>
</div>
<div class="col-12 col-sm-5">
    <label class="form-label" for="filter-day">Dzień</label>
    <input id="filter-day" class="form-control" type="date" name="day" value="{{.Filters.Day}}">
</div>
<div class="col-12 col-sm-2 d-grid">
    <button class="btn btn-primary" type="submit">Filtruj</button>
</div>
</form>

{{if not .Reports}}
<div class="alert alert-info">Brak raportów spełniających kryteria.</div>
{{end}}

<div class="row row-cols-1 row-cols-md-2 g-3">
{{range .Reports}}
    <div class="col">
    <div class="card card-hover shadow-sm h-100">
        <div class="card-body">
        <div class="d-flex justify-content-between align-items-start mb-2">
            <h6 class="card-title mb-0">Raport #{{.Id}}</h6>
            <span class="badge text-bg-secondary">v{{.Version}}</span>
        </div>
        <div class="small text-body-secondary mb-2">
            {{.IncidentTime.Format "2006-01-02 15:04"}} • {{.IncidentLocation}}
        </div>
        <div class="mb-2">
            <span class="badge rounded-pill text-bg-light">{{.PatientName}}</span>
            {{if gt .PatientAge 0}}<span class="badge rounded-pill text-bg-light">{{.PatientAge}} lat</span>{{end}}
            {{if .PatientSex}}<span class="badge rounded-pill text-bg-light">{{.PatientSex}}</span>{{end}}
        </div>
        <div class="d-flex flex-wrap gap-1 mb-2">
            {{if gt .HR 0}}<span class="badge text-bg-primary vital-badge">HR {{.HR}}</span>{{end}}
            {{if gt .SpO2 0}}<span class="badge text-bg-primary vital-badge">SpO₂ {{.SpO2}}%</span>{{end}}
            {{if or (gt .BPSys 0) (gt .BPDia 0)}}<span class="badge text-bg-primary vital-badge">BP {{.BPSys}}/{{.BPDia}}</span>{{end}}
            {{if gt .Glucose 0}}<span class="badge text-bg-primary vital-badge">Glu {{.Glucose}}</span>{{end}}
        </div>
        <p class="card-text text-truncate">{{.Symptoms}}</p>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-secondary btn-sm" data-bs-toggle="modal" data-bs-target="#m-{{.Id}}-{{.Version}}">Podgląd</button>
            <a class="btn btn-outline-primary btn-sm" href="/reports/view/{{.Id}}?v={{.Version}}">Szczegóły</a>
            <a class="btn btn-outline-dark btn-sm" href="/reports/history/{{.Id}}">Historia</a>
            <a class="btn btn-primary btn-sm" href="/reports/edit/{{.Id}}?v={{.Version}}">Edytuj</a>
            <a class="btn btn-success btn-sm" href="/reports/version/{{.Id}}?v={{.Version}}">Nowa wersja</a>
        </div>
        </div>
    </div>
    </div>

    <!-- Modal preview -->
    <div class="modal fade" id="m-{{.Id}}-{{.Version}}" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-scrollable">
        <div class="modal-content">
        <div class="modal-header">
            <h5 class="modal-title">Raport #{{.Id}} (v{{.Version}})</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Zamknij"></button>
        </div>
        <div class="modal-body">
            <dl class="kv kv-modal">
            <dt>Data zdarzenia</dt><dd>{{.IncidentTime.Format "2006-01-02 15:04"}}</dd>
            <dt>Miejsce</dt><dd>{{.IncidentLocation}}</dd>
            <dt>Pacjent</dt><dd>{{.PatientName}} {{if gt .PatientAge 0}}({{.PatientAge}}){{end}} {{.PatientSex}}</dd>
            {{if .Symptoms}}<dt>Objawy</dt><dd>{{.Symptoms}}</dd>{{end}}
            {{if .Interventions}}<dt>Interwencje</dt><dd>{{.Interventions}}</dd>{{end}}
            {{if .Notes}}<dt>Notatki</dt><dd>{{.Notes}}</dd>{{end}}
            </dl>
        </div>
        <div class="modal-footer">
            <a class="btn btn-outline-primary" href="/reports/view/{{.Id}}?v={{.Version}}">Szczegóły</a>
            <a class="btn btn-primary" href="/reports/edit/{{.Id}}?v={{.Version}}">Edytuj</a>
        </div>
        </div>
    </div>
    </div>

{{end}}
</div>

{{/* Pagination (optional) */}}
{{with .Pagination}}
{{if gt .TotalPages 1}}
    <nav class="mt-3" aria-label="Stronicowanie">
    <ul class="pagination pagination-sm">
        {{/* simplistic example; wire up real links with current filters */}}
        <li class="page-item {{if eq .Page 1}}disabled{{end}}"><a class="page-link" href="?page={{sub .Page 1}}">«</a></li>
        <li class="page-item disabled"><span class="page-link">Strona {{.Page}} / {{.TotalPages}}</span></li>
        <li class="page-item {{if eq .Page .TotalPages}}disabled{{end}}"><a class="page-link" href="?page={{add .Page 1}}">»</a></li>
    </ul>
    </nav>
{{end}}

{{end}}
{{end}}

{{define "list"}}
  {{template "layout" .}}
{{end}}
