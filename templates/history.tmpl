{{define "title"}}Historia raportu #{{.ReportID}}{{end}}
{{define "content"}}
<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="h4 mb-0">Historia raportu #{{.ReportID}}</h1>
  <a class="btn btn-outline-secondary btn-sm" href="/reports">Powrót do listy</a>
</div>

{{if not .Reports}}
<div class="alert alert-info">Brak wersji raportu.</div>
{{end}}

<div class="list-group">
  {{range .Reports}}
  <div class="list-group-item d-flex justify-content-between align-items-center">
    <div>
      <div class="fw-semibold">Wersja v{{.Version}}</div>
      <div class="small text-body-secondary">{{.IncidentTime.Format "2006-01-02 15:04"}} • {{.IncidentLocation}}</div>
    </div>
    <div class="d-flex gap-2">
      <a class="btn btn-outline-primary btn-sm" href="/reports/view/{{.Id}}?v={{.Version}}">Szczegóły</a>
      <a class="btn btn-primary btn-sm" href="/reports/edit/{{.Id}}?v={{.Version}}">Edytuj</a>
    </div>
  </div>
  {{end}}
</div>
{{end}}

{{define "full_view"}}
  {{template "layout" .}}
{{end}}
