{{define "layout"}}
<!doctype html>
<html lang="pl" data-bs-theme="light">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{block "title" .}}Raporty – Pierwsza Pomoc{{end}}</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    /* Mobile-first spacing tweaks */
    .card-hover { transition: transform .05s ease-in-out; }
    .card-hover:active { transform: scale(0.99); }
    .kv { display:flex; gap:.5rem; flex-wrap:wrap; }
    .kv dt { font-weight:600; }
    .kv dd { margin:0; }
    .kv-modal { display:block; }
    .kv-modal dt { margin-top:.5rem; }
    .kv-modal dt:first-child { margin-top:0; }
    .kv-modal dd { margin:0 0 .5rem 0; }
    .vital-badge { font-variant-numeric: tabular-nums; }
    .form-section { border-left: 4px solid var(--bs-border-color); padding-left: .75rem; margin-bottom: 2rem; }
  </style>
</head>
<body class="bg-body-tertiary">
  <nav class="navbar navbar-expand-lg bg-body shadow-sm sticky-top">
    <div class="container">
      <a class="navbar-brand" href="/reports">⛑️ Interwencje</a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div id="nav" class="collapse navbar-collapse">
        <ul class="navbar-nav ms-auto align-items-lg-center">
          {{if .CurrentUser}}<li class="nav-item"><span class="navbar-text small">Zalogowano: {{.CurrentUser}}</span></li>{{end}}
        </ul>
      </div>
    </div>
  </nav>

  <main class="container py-3">
    {{block "content" .}}{{end}}
  </main>

  <script src="https://unpkg.com/htmx.org@2.0.4"></script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
    // Sync helper for dual inputs (number <-> range) within .measure-widget blocks
    document.addEventListener('input', function(e){
      const root = e.target.closest('.measure-widget');
      if(!root) return;
      const num = root.querySelector('input[type="number"]');
      const rng = root.querySelector('input[type="range"]');
      if(!num || !rng) return;
      if(e.target === num){ rng.value = num.value; }
      if(e.target === rng){ num.value = rng.value; }
    });
    // Enable/disable inputs based on checkbox
    document.addEventListener('change', function(e){
      const cb = e.target.closest('.measure-widget')?.querySelector('input[type="checkbox"]');
      const root = e.target.closest('.measure-widget');
      if(!root || !cb) return;
      const controls = root.querySelectorAll('input[type="number"], input[type="range"]');
      const disabled = !cb.checked;
      controls.forEach(el => { el.disabled = disabled; if(disabled){ el.value = ''; } });
    });
    // Initialize states on load
    window.addEventListener('DOMContentLoaded', function(){
      document.querySelectorAll('.measure-widget').forEach(root =>{
        const cb = root.querySelector('input[type="checkbox"]');
        const controls = root.querySelectorAll('input[type="number"], input[type="range"]');
        const disabled = !(cb && cb.checked);
        controls.forEach(el => el.disabled = disabled);
      });
    });
  </script>
</body>
</html>
{{end}}
